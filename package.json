{
  "name": "nexus-ecommerce",
  "version": "1.0.0",
  "description": "Production-Grade AI-Assisted E-Commerce Web Application",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix server install && npm --prefix server run build",
    "build:railway": "npm --prefix server install && npm --prefix server run build && npm --prefix server exec prisma generate",
    "start": "node server/dist/server.js",
    "test:server": "npm --prefix server test",
    "test": "npm run test:server",
    "seed": "npm --prefix server run prisma:seed"
  },
  "keywords": ["ecommerce", "react", "nodejs", "prisma", "typescript", "tailwind"],
  "author": "",
  "license": "ISC"
}
